{
    "name": "openeuropa/oe_bootstrap_theme",
    "description": "OpenEuropa Bootstrap base theme.",
    "type": "drupal-theme",
    "license": "EUPL-1.2",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "cweagans/composer-patches": "^1.7",
        "drupal/core": "^10.3 || ^11",
        "drupal/file_link": "dev-3430560-automated-drupal-11",
        "drupal/ui_patterns": "^1.10",
        "drupal/ui_patterns_settings": "^2.3",
        "openeuropa/ecl-twig-loader": "^4.0"
    },
    "require-dev": {
        "ext-dom": "*",
        "composer/installers": "^1.11",
        "drupal/core-composer-scaffold": "^10.3 || ^11",
        "drupal/core-dev": "^10.3 || ^11",
        "drupal/styleguide": "dev-custom",
        "drush/drush": "^12 || ^13",
        "nikic/php-parser": "^4",
        "openeuropa/code-review-drupal": "^1.0.0-alpha",
        "openeuropa/task-runner-drupal-project-symlink": "^1.0",
        "phpspec/prophecy-phpunit": "^2"
    },
    "scripts": {
        "post-install-cmd": "./vendor/bin/run drupal:site-setup",
        "post-update-cmd": "./vendor/bin/run drupal:site-setup"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8",
            "exclude": [
                "drupal/file_link",
                "drupal/styleguide"
            ]
        },
        {
            "type": "git",
            "url": "https://github.com/openeuropa/code-review-drupal.git"
        },
        {
            "type": "git",
            "url": "https://git.drupalcode.org/issue/file_link-3430560.git",
            "reference": "e919bf13b4a14ac0bb1504bcbd04a80504466bb4"
        },
        {
            "type": "package",
            "package": {
                "name": "drupal/styleguide",
                "version": "dev-custom",
                "type": "drupal-module",
                "source": {
                    "type": "git",
                    "url": "https://git.drupalcode.org/issue/styleguide-3505640.git",
                    "reference": "34af6d9ac2e45ab5826e6ab4e8637c06a59056f6"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Drupal\\oe_bootstrap_theme\\": "./src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Drupal\\Tests\\oe_bootstrap_theme\\": "./tests/src"
        }
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "enable-patching": true,
        "installer-paths": {
            "build/core": ["type:drupal-core"],
            "build/profiles/contrib/{$name}": ["type:drupal-profile"],
            "build/modules/contrib/{$name}": ["type:drupal-module"],
            "build/themes/contrib/{$name}": ["type:drupal-theme"]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "./build"
            }
        },
        "patches": {
            "drupal/ui_patterns_settings": {
                "Case mismatch between loaded and declared class names @see https://www.drupal.org/project/ui_patterns_settings/issues/3508198": "https://www.drupal.org/files/issues/2025-02-21/3508198-case-mismatch.patch"
            }
        },
        "_readme": [
            "Explicit requirement of nikic/php-parser ^4 as later versions are not compatible with grumphp @see https://github.com/phpro/grumphp/issues/1119"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "php-http/discovery": false,
            "phpro/grumphp-shim": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": false
        }
    }
}
