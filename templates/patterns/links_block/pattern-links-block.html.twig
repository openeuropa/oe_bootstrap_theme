{#
/**
 * @file
 * Links block pattern.
 */
#}
{% set _links = [] %}
{% if links is not empty %}
  {% for _link in links %}
    {% set _links = _links|merge([
      _link|merge({
        icon_display: (_link.icon is defined and _link.icon) ? 'flex' : ''
      })
    ]) %}
  {% endfor %}
{% endif %}

{% include '@oe-bcl/links-block' with {
  background: background,
  variant: orientation,
  title: title,
  title_tag: title_tag,
  links: _links,
  attributes: attributes,
} only %}
