{#
/**
 * @file
 * Progress pattern.
 */
#}
{# Render slots first, so that render arrays with empty output count as empty. #}
{% set label = label|render %}
{% set text = text|render %}
{% set message = message|render %}
{% include '@oe-bcl/progress' with {
  'progress': progress,
  'min': min,
  'max': max,
  'message': message,
  'striped': striped,
  'animated': animated,
  'label': label,
  'variant': style,
  'bar_label': text,
  'attributes': attributes,
} only %}
