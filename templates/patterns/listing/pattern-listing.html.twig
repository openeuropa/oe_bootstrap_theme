{#
/**
 * @file
 * Listing pattern.
 */
#}
{# Render slots first, so that render arrays with empty output count as empty. #}
{% set title = title|render %}
{% include '@oe-bcl/listing' with {
  'variant': variant|default('default') ~ '-' ~ columns|default('1') ~ '-col',
  'items': items|bcl_card_list,
  'link': link ? {
    'path': link.path,
    'label': link.label,
    'icon': {
      'path': bcl_icon_path(),
    },
  } : null,
  'title': title,
  'title_tag': title_tag,
  'attributes': create_attribute(attributes ?? {}).addClass('text-break'),
} only %}
