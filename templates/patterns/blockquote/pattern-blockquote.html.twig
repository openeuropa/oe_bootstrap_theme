{#
/**
 * @file
 * Blockquote pattern.
 */
#}
{# Render slots first, so that render arrays with empty output count as empty. #}
{% set title = title|render %}
{% set attribution = attribution|render %}
{% if attribution and cite %}
  {#- Append a space between attribution and cite. #}
  {#- @todo This should be fixed in BCL eventually. #}
  {%- set attribution %}{{ attribution }} {% endset %}
{% endif %}
{% include '@oe-bcl/blockquote' with {
  'title': title,
  'title_tag': title_tag,
  'quote': quote,
  'attribution': attribution,
  'cite': cite,
  'alignment': alignment,
  'attributes': attributes,
} only %}
