{#
/**
 * @file
 * Description list pattern.
 *
 * @todo Fail if an item has a missing, empty or malformed term.
 */
#}
{% include '@oe-bcl/description-list' with {
  'title': title,
  'title_tag': title_tag,
  'items': (items ?? [])|map(item => item|merge({
    term: (item.term is iterable)
      ? (item.term|map(term => (term is iterable and term.icon) ? term|merge({
        icon: {
          size: 'xs',
          path: bcl_icon_path,
          ...(term.icon is iterable ? term.icon : {name: term.icon}),
        },
      }) : term))
      : [{
        label: item.term,
      }],
  })),
  'variant': orientation,
  'attributes': attributes,
} only %}
