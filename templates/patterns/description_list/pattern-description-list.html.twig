{# Render slots first, so that render arrays with empty output count as empty. #}
{% set title = title|render %}
{% include '@oe-bcl/description-list' with {
  'title': title,
  'title_tag': title_tag,
  'items': items,
  'variant': orientation,
  'attributes': create_attribute(attributes ?? {}),
} only %}
