{#
/**
 * @file
 * Default template for "Media container" pattern.
 */
#}

{# Parameters:
  - media: Media markup (image, video, iframe…).
  - description: Optional description rendered underneath the media.
  - copyright: Optional configuration passed to the copyright overlay pattern. Provide an array
    matching the copyright_overlay fields (content, trigger_label, modal_title, etc.).
  - tag: HTML tag for the outer wrapper. Defaults to <figure>.
  - attributes: Attributes for the outer wrapper.
#}

{% set tag = tag|default('figure') %}
{% set attributes = attributes|default(create_attribute()) %}

{% set has_media = media is not empty %}
{% set has_description = description is not empty %}
{% set has_copyright = copyright is not empty %}

{% if has_media or has_description %}
  <{{ tag }}{{ attributes.addClass('media-container') }}>
    {% if has_media %}
      <div class="media-container__media position-relative">
        {{ media }}
        {% if has_copyright %}
          {{ pattern('copyright_overlay', copyright) }}
        {% endif %}
      </div>
    {% endif %}
    {% if has_description %}
      <figcaption class="media-container__description">
        {{ description }}
      </figcaption>
    {% endif %}
  </{{ tag }}>
{% endif %}
