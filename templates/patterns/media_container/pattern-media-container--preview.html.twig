{#
/**
 * @file
 * Template override for preview mode of "Media container" pattern.
 */
#}
{% set image_media %}
  <img class="img-fluid" src="https://picsum.photos/800/450" alt="Sample landscape image">
{% endset %}
{% set image_description %}
  <p>Landscape photography showcasing diverse European regions.</p>
{% endset %}
{% set image_copyright %}
  <span>© European Commission, 2024</span>
{% endset %}

{% set video_media %}
  <video class="w-100" controls>
    <source src="https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.mp4" type="video/mp4">
  </video>
{% endset %}
{% set video_description %}
  <p>Highlights from the latest policy briefing. Captions and credits appear below for playable media.</p>
{% endset %}

<div class="row g-4">
  <div class="col-12 col-md-6">
    {{ pattern('media_container', {
      media: image_media,
      description: image_description,
      copyright: {
        content: image_copyright
      }
    }) }}
  </div>
  <div class="col-12 col-md-6">
    {{ pattern('media_container', {
      media: video_media,
      description: video_description,
      copyright: {
        content: image_copyright
      }
    }) }}
  </div>
</div>
