{#
/**
 * @file
 * Pagination pattern.
 */
#}

{% set internal_items = (items ?? [])|map(item => item|merge({
  'attributes': create_attribute({'aria-label': item.label}).merge(item.attributes|default(create_attribute())),
})) %}

{% set _controls = {
  first: { item: first, label: 'First'|t },
  prev: { item: prev, label: 'Previous'|t },
  next: { item: next, label: 'Next'|t },
  last: { item: last, label: 'Last'|t },
} %}
{% set _controls = _controls|filter(_control => _control.item) %}
{% set _control_items = _controls|map(_control => _control.item|merge({
  'attributes': create_attribute({
    'aria-label': _control.item.aria_label|default(_control.label),
  }).merge(_control.item.attributes|default(create_attribute())),
})) %}

{% include '@oe-bcl/pagination' with {
  'variant': variant,
  'size': size,
  'alignment': alignment,
  'aria_label': aria_label,
  'enable_prev_next_icon': enable_prev_next_icons,
  'enable_first_last_icon': enable_first_last_icons,
  ..._control_items,
  'items': internal_items,
  'attributes': attributes,
  'icon_path': bcl_icon_path,
  'list_attributes': list_attributes.addClass('js-pager__items'),
} only %}
