{
  "name": "oe_bootstrap_theme",
  "version": "1.0.0",
  "description": "OpenEuropa Bootstrap base theme for Drupal.",
  "private": true,
  "scripts": {
    "build": "pnpm run build:styles && pnpm run build:copy && pnpm run build:rename",
    "build:styles": "cross-env bcl-builder styles",
    "build:copy": "cross-env bcl-builder copy",
    "build:rename": "cross-env bcl-builder rename",
    "watch:styles": "chokidar \"./resources/sass/**/*.scss\" -i \"/node_modules/\" -c \"pnpm run build:styles\"",
    "watch": "pnpm run watch:styles",
    "production": "pnpm run build"
  },
  "devDependencies": {
    "@openeuropa/bcl-builder": "^1.17",
    "@openeuropa/bcl-theme-default": "^1.17",
    "bootstrap-ie11": "5.0.2",
    "chokidar-cli": "^3.0.0",
    "copyfiles": "2.4.1",
    "cross-env": "7.0.3",
    "glob": "10.0.0"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.0.0"
  }
}
