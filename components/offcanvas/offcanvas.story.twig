{% for variant, variant_title in {
  default: 'Default',
  search: 'Search',
} %}
  <section class="my-4">
    <h3 class="my-3">{{ variant_title }} (<code>{{ variant }}</code>)</h3>
    {{ include_only('oe_bootstrap_theme:offcanvas', {
      variant: variant,
      placement: 'start',
      backdrop: true,
      title: 'An offcanvas title',
      body: {
        '#markup': '<div>
      <p>An interesting content for this offcanvas.</p>
      <div class="d-none d-lg-block">
        <p><em>Resize to a narrower viewport to activate the offcanvas hide/show mechanism.</em></p>
      </div>
      <div class="d-lg-none">
        <p><em>Resize to a wider viewport to deactivate the offcanvas hide/show mechanism.</em></p>
      </div>
    </div>
    ',
      },
      toggle: {
        label: 'Toggle',
        icon: 'filter',
        attributes: {
          class: [
            'd-lg-none',
          ],
        },
      },
    }) }}
  </section>
{% endfor %}