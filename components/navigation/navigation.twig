{#
/**
 * @file
 * Navigation component.
 */
#}
{% set _variant = variant|default('default') %}

{% set fn_prepare_navigation_element = item => item
  |without_nulls
  |bcl_expand_attributes
  |bcl_expand_icon(path: icon_path)
  |merge({
    spinner: item.spinner ? item.spinner|bcl_expand_attributes : null,
    dark: item.dark_mode ?? null,
  }|without_nulls)
%}

{% include '@oe-bcl/navigation' with {
  id: navigation_id,
  items: (items ?? [])|map(item => item
    |arrow(fn_prepare_navigation_element)
    |merge({
      spinner: item.spinner ? item.spinner|bcl_expand_attributes : null,
      dark: item.dark_mode ?? null,
      trigger: (item.dropdown or item.trigger)
        ? (item.trigger ?? {})|arrow(fn_prepare_navigation_element)
        : null,
      items: item.items ? item.items|map(fn_prepare_navigation_element) : null,
    }|without_nulls)
  ),
  items_: items|map(_item => _item|merge({
    icon_path: bcl_icon_path,
  })),
  pills: _variant == 'pills',
  tabs: _variant == 'tabs',
  tabs_content: tabs_content ?? false,
  vertical: orientation|default('horizontal') == 'vertical',
  full_width: full_width ?? false,
  alignment: alignment,
  nav: _variant in ['pills', 'tabs'],
  navbar: _variant == 'navbar',
  attributes: attributes,
} only %}
