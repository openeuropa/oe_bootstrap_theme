{#
/**
 * @file
 * Default template for "Card V2" component.
 *
 * For available variables, refer to the pattern declaration.
 */
#}

{% set _classes = ['card', 'v2'] %}

{% if variant == 'horizontal' %}
  {% set _classes = _classes|merge(['horizontal']) %}
{% endif %}

{% set tag = tag|default('article') %}
{% set attributes = create_attribute(attributes ?? {}) %}
{% set media_attributes = create_attribute(media_attributes ?? {}) %}
{% set header_attributes = create_attribute(header_attributes ?? {}) %}
{% set content_attributes = create_attribute(content_attributes ?? {}) %}
{% set footer_attributes = create_attribute(footer_attributes ?? {}) %}

<{{ tag }}{{ attributes.addClass(_classes) }}>
  {% if media is not empty %}
    <div{{ media_attributes.addClass(['card-media']) }}>
      {{ media }}
    </div>
  {% endif %}
  {% if header is not empty %}
    <div{{ header_attributes.addClass(['card-header']) }}>
      {{ header }}
    </div>
  {% endif %}
  <div{{ content_attributes.addClass(['card-body']) }}>
    {% if title is not empty %}
      <div class="card-title">
        {{ title }}
      </div>
    {% endif %}
    {{ content }}
  </div>
  {% if footer is not empty %}
    <div{{ footer_attributes.addClass(['card-footer']) }}>
      {{ footer }}
    </div>
  {% endif %}
</{{ tag }}>
