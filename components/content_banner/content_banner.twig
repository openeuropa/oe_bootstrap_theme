{#
/**
 * @file
 * Content banner component.
 */
#}
{% set _title_attributes = create_attribute(title_attributes ?? {}) %}
{%- set _content -%}
  {%- set content_attributes = create_attribute().addClass(['mt-4', 'card-content']) -%}
  {%- if meta is not empty -%}
    {%- set content_attributes = create_attribute().addClass('card-content') -%}
    <div class="my-4">
      {%- for meta_item in meta -%}
        {%- if meta_item is not empty -%}
          <span class="text-muted me-3">{{- meta_item -}}</span>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- if content is not empty -%}
    <div{{ content_attributes }}>{{- content -}}</div>
  {%- endif -%}
{%- endset -%}

{%- include '@oe-bcl/bcl-content-banner/bcl-content-banner.html.twig' with {
  background: background,
  title: title,
  title_tag: title_tag|default('h1'),
  title_link: title_link|bcl_expand_attributes|bcl_expand_icon,
  title_attributes: _title_attributes,
  subtitle: subtitle,
  text: text,
  content: _content,
  image: image ? image|merge({
    path: image.src ?? '',
    alt: image.alt ?? '',
  }) : {},
  date: date ? date|bcl_expand_attributes|merge({
    icon_path: date.icon_path ?: bcl_icon_path(),
  }) : {},
  copyright: copyright,
  copyright_label: copyright_label|default('Image credit:'|t),
  image_size: image_size|default('lg'),
  badges: (badges ?? [])|map(badge => badge|bcl_expand_attributes|merge({
    outline: badge.outline ?? true,
  })|bcl_expand_attributes),
  links: (links ?? [])|map(link => link|bcl_expand_attributes|bcl_expand_icon),
  action_bar: action_bar,
  attributes: attributes,
} only -%}
