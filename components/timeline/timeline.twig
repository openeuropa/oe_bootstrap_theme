{#
/**
 * @file
 * Timeline component.
 */
#}
{% set _title_attributes = create_attribute(title_attributes ?? {}) %}
{% set _icon_path = icon_path|default(bcl_icon_path()) %}

{% set _items = (items ?? [])|map(item => item|bcl_expand_attributes()) %}
{% set _title_link = title_link ? title_link|bcl_expand_attributes|bcl_expand_icon(path: _icon_path) : {} %}

{% include '@oe-bcl/timeline' with {
  toggle_collapsed: collapse_button_label|default('Show more %d items'|t),
  toggle_expanded: expand_button_label|default('Hide %d items'|t),
  hide: {
    from: hide_from,
    to: hide_to|default(0),
  },
  items: _items,
  icon_path: _icon_path,
  attributes: attributes,
  title: title,
  title_link: _title_link,
  title_tag: title_tag,
  title_attributes: _title_attributes,
} only %}
