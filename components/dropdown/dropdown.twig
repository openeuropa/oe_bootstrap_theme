{#
/**
 * @file
 * Dropdown component.
 */
#}
{% set _icon_path = icon_path|default(bcl_icon_path()) %}

{% set _trigger = trigger|default({}) %}
{% set _trigger = _trigger|merge({
  label: _trigger.label|default(button_label|default('')),
}) %}
{% set _trigger = _trigger|bcl_expand_attributes|bcl_expand_icon(path: _icon_path) %}

{% set _items = (items ?? [])|map(item => item
  |without_nulls
  |bcl_expand_attributes
  |bcl_expand_icon(path: _icon_path)
) %}

{% include '@oe-bcl/dropdown' with {
  id: dropdown_id|default('bcl-dropdown'|clean_unique_id),
  trigger: _trigger,
  link: link ?? false,
  direction: direction,
  alignment: alignment,
  dark: dark_mode ?? false,
  remove_wrapper: remove_wrapper ?? false,
  inside_navigation: inside_navigation ?? false,
  items: _items,
  attributes: attributes,
} only %}
