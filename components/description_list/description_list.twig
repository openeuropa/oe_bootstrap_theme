{#
/**
 * @file
 * Description list component.
 */
#}
{% set _title_attributes = create_attribute(title_attributes ?? {}) %}
{% set _icon_path = icon_path|default(bcl_icon_path()) %}

{% include '@oe-bcl/description-list' with {
  title: title,
  title_link: title_link ? title_link|bcl_expand_attributes|bcl_expand_icon(path: _icon_path) : {},
  title_tag: title_tag|default('h2'),
  title_attributes: _title_attributes,
  items: (items ?? [])|map(item => item|merge({
    term: (item.term and item.term is iterable)
      ? item.term|map(term => term|bcl_expand_icon(path: _icon_path, size: 'xs'))
      : item.term
  })),
  variant: orientation,
  bordered: bordered,
  col_classes: col_classes,
  attributes: attributes,
} only %}
