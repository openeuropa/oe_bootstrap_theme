{#
/**
 * @file
 * Banner component.
 */
#}
{% set _variant = variant ?: 'default' %}
{% set _shade = shade ?? _variant == 'image_shade' %}
{% set _attributes = attributes|default(create_attribute()) %}

{% if _variant == 'primary' %}
  {% set _attributes = _attributes.addClass(['bg-primary', 'text-white']) %}
{% elseif _variant == 'image_shade' %}
  {% set _attributes = _attributes.addClass(['bg-lighter']) %}
{% else %}
  {% set _attributes = _attributes.addClass(['bg-lighter', 'text-dark']) %}
{% endif %}

{% if centered %}
  {% set _attributes = _attributes.addClass(['text-center']) %}
{% endif %}

{% set _call_to_action = call_to_action|default({}) %}
{% if _call_to_action and _call_to_action.link_style is defined %}
  {% set _call_to_action = _call_to_action|merge({variant: _call_to_action.link_style}) %}
{% endif %}
{% if _call_to_action.icon is defined and _call_to_action.icon is not empty and _call_to_action.icon.path is not defined %}
  {% set _call_to_action = _call_to_action|merge({
    icon: _call_to_action.icon|merge({path: bcl_icon_path()})
  }) %}
{% endif %}

{% include '@oe-bcl/banner' with {
  shade: _shade,
  hero: hero,
  full_width: full_width,
  centered: centered,
  title: title,
  title_tag: title_tag,
  description: description,
  link: _call_to_action,
  copyright: _variant in ['image', 'image_shade'] ? copyright : '',
  copyright_label: _variant in ['image', 'image_shade'] ? 'Image credit:'|t : '',
  image: _variant in ['image', 'image_shade'] ? image : '',
  content_classes: content_classes,
  attributes: _attributes,
} only %}
