{% set label = 'Submit' %}
{% set icon = 'arrow-right' %}

{% for variant, variant_title in {
  primary: 'Primary (default)',
  secondary: 'Secondary',
  success: 'Success',
  danger: 'Danger',
  warning: 'Warning',
  info: 'Info',
  light: 'Light',
  dark: 'Dark',
  link: 'Link',
} %}
  <section class="my-4">
    <h3 class="my-3">{{ variant_title }} (<code>{{ variant }}</code>)</h3>
    {#
    /**
     * @file
     * Template override for preview mode of "Button" pattern.
     */
    #}
    {% if variant == 'primary' %}
      <div class="vstack gap-3">
        <p class="mb-0">
          Text before
          {{ include_only('oe_bootstrap_theme:button', {
            label: 'Simple button',
            variant: 'primary',
          }) }}
          and more text after to show inline flow.
        </p>

        <p class="mb-0">
          Text before
          {{ include_only('oe_bootstrap_theme:button', {
            label: 'Button with icon before',
            variant: 'primary',
            icon: 'arrow-right',
            icon_position: 'before',
          }) }}
          plus some extra text after the button.
        </p>

        <p class="mb-0">
          Text before
          {{ include_only('oe_bootstrap_theme:button', {
            label: 'Button with icon after',
            variant: 'primary',
            icon: 'arrow-right',
            icon_position: 'after',
          }) }}
          and more text after it for context.
        </p>
      </div>
    {% else %}
      {{ include_only('oe_bootstrap_theme:button', {
        'label': label,
        'variant': variant,
        'icon': icon,
        'outline': outline,
        'size': size,
        'type': type,
        'disabled': disabled,
        'icon_position': icon_position,
        'attributes': attributes,
      }) }}
    {% endif %}
  </section>
{% endfor %}