{#
/**
 * @file
 * Link component.
 */
#}
{# Render slots first, so that render arrays with empty output count as empty. #}
{% set label = label|render %}
{% include '@oe-bcl/link' with {
  label: label,
  path: path,
  disabled: disabled,
  icon: icon|bcl_icon,
  icon_position: icon_position,
  icon_display: icon_display,
  remove_icon_spacers: remove_icon_spacers,
  standalone: standalone,
  attributes: create_attribute(attributes ?? {}),
} only %}
