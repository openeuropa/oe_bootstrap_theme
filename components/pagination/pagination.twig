{#
/**
 * @file
 * Pagination component.
 */
#}
{% set _variant = variant|default('default') %}
{% set _icon_path = icon_path|default(bcl_icon_path()) %}
{% set _attributes = attributes|default(create_attribute()) %}
{% set _list_attributes = create_attribute(list_attributes ?? {}).addClass('js-pager__items') %}

{% if _variant == 'glossary' and not _attributes.hasAttribute('aria-label') and not _attributes.hasAttribute('aria-labelledby') %}
  {% set _attributes = _attributes.setAttribute('aria-label', 'Glossary links'|t) %}
{% endif %}

{% set fn_process_item = item => item
  |bcl_expand_attributes(defaults: {'aria-label': item.label|default(null)}|without_nulls)
  |bcl_expand_icon(path: _icon_path, size: 'fluid')
  |arrow(item => item|merge({icon_path: item.icon.path ?: null}|without_nulls))
%}

{% set _controls = {
  first: { item: first, label: 'First'|t },
  prev: { item: prev, label: 'Previous'|t },
  next: { item: next, label: 'Next'|t },
  last: { item: last, label: 'Last'|t },
}
  |filter(control => control.item)
  |map(control => control.item|merge({label: control.label}))
  |map(fn_process_item)
%}

{% set _items = (items ?? [])|map(fn_process_item) %}

{% include '@oe-bcl/pagination' with {
  variant: _variant == 'default' ? '' : _variant,
  size: size,
  alignment: alignment,
  enable_prev_next_icon: enable_prev_next_icons,
  enable_first_last_icon: enable_first_last_icons,
  ellipsis_before: ellipsis_before,
  ellipsis_after: ellipsis_after,
  ..._controls,
  items: _items,
  icon_path: _icon_path,
  attributes: _attributes,
  list_attributes: _list_attributes,
} only %}
