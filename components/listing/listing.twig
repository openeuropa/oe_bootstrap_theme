{% include '@oe-bcl/listing' with {
  variant: variant|default('default') ~ '-' ~ columns|default('1') ~ '-col',
  items: items|map(item => item|merge({
    image_copyright_label: item.image_copyright ? 'Image credit:'|t : null,
  }|without_nulls))|bcl_card_list,
  link: link ? {
    path: link.path,
    label: link.label,
    icon: bcl_icon_path() ? {
      path: bcl_icon_path(),
    } : null,
  } : null,
  title: title,
  title_tag: title_tag,
  attributes: attributes.addClass('text-break'),
} only %}
