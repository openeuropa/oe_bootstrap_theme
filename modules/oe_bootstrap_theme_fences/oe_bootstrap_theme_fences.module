<?php

/**
 * @file
 * Hook implementations for OpenEuropa Bootstrap Theme Fences module.
 */

declare(strict_types=1);

/**
 * Implements hook_theme_registry_alter().
 */
function oe_bootstrap_theme_fences_theme_registry_alter(array &$theme_registry): void {
  $theme_path = \Drupal::service('extension.list.theme')->getPath('oe_bootstrap_theme');
  $module_path = \Drupal::service('extension.list.module')->getPath('oe_bootstrap_theme_fences');
  foreach (['field', 'field__bare'] as $hook) {
    // Only replace the templates that come from the base theme.
    if (isset($theme_registry[$hook]['path']) && str_starts_with($theme_registry[$hook]['path'], $theme_path . '/')) {
      $theme_registry[$hook]['path'] = $module_path . '/templates';
    }
  }
}
