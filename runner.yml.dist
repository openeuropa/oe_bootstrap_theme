drupal:
  root: "build"
  base_url: "http://web:8080/build"
  site:
    name: "OpenEuropa Bootstrap base theme"
    profile: "minimal"
  database:
    host: "mysql"
    port: "3306"
    name: "drupal"
    user: "root"
    password: ""
  post_install:
    # Prepare the instance.
    - { task: "exec", command: "./vendor/bin/drush en oe_bootstrap_theme_helper styleguide -y" }
    - { task: "exec", command: "./vendor/bin/drush en field_ui -y" }
    - { task: "exec", command: "./vendor/bin/drush en toolbar -y" }
    - { task: "exec", command: "./vendor/bin/drush theme:enable oe_bootstrap_theme -y" }
    - { task: "exec", command: "./vendor/bin/drush theme:enable claro -y" }
    - { task: "exec", command: "./vendor/bin/drush config-set system.theme default oe_bootstrap_theme -y" }
    - { task: "exec", command: "./vendor/bin/drush config-set system.theme admin claro -y" }
    - { task: "exec", command: "./vendor/bin/drush config-set node.settings use_admin_theme 1 -y" }
    - { task: "exec", command: "./vendor/bin/drush config-set system.logging error_level verbose -y" }
    - { task: "exec", command: "./vendor/bin/drush cr" }
  additional_settings: |
    $settings['file_scan_ignore_directories'] = [
      'node_modules',
      'bower_components',
      'vendor',
      'build',
    ];

selenium:
  host: "http://selenium"
  port: "4444"
  browser: "chrome"

commands:
  drupal:site-setup:
    - { task: "exec", command: "npx --yes --package=npm@12.0.2 npm ci --ignore-scripts" }
    - { task: "exec", command: "npm run apply-patches" }
    - { task: "exec", command: "npm run build" }
    - { task: "run", command: "drupal:symlink-project" }
    - { task: "run", command: "drupal:drush-setup" }
    - { task: "run", command: "drupal:settings-setup" }
    - { task: "copy", from: "build/sites/default/default.services.yml", to: "build/sites/default/services.yml" }
    - { task: "run", command: "setup:phpunit" }
  setup:phpunit:
    - { task: "process", source: "phpunit.xml.dist", destination: "phpunit.xml" }
    - { task: "remove", file: "build/sites/default/settings.testing.php" }
    - task: "append"
      file: "build/sites/default/settings.testing.php"
      text: |
        <?php

        $settings['extension_discovery_scan_tests'] = TRUE;

  toolkit:code-review:
    - { task: "exec", command: "./vendor/bin/grumphp run --verbose" }

  # The `toolkit:test-phpunit` command is called in the gitlab CI pipeline.
  # It needs to be overridden to work properly with PhpUnit 9, where the
  # `--log-junit` option needs an absolute path.
  # For local development, simply ignore this command and run phpunit directly.
  toolkit:test-phpunit:
    - { task: "exec", command: "./vendor/bin/phpunit --log-junit $(pwd)/junit-export/junit-phpunit.xml" }

release:
  drupal_info_files:
    - oe_bootstrap_theme.info.yml
  tasks:
    - { task: "copy", from: "assets", to: "_release_/assets" }

toolkit:
  build:
    custom-code-folder: '${drupal.root}/modules/custom'
  lint:
    eslint:
      options_yaml: 'no-error-on-unmatched-pattern'
      options_js: 'no-error-on-unmatched-pattern'
  test:
    phpunit: {}
  ci:
    PHP:
      - 8.3
    DRUPAL:
      - ~10.6.0
      - ~11.3.0
      - ~11.4.0
    PUBLISH: false
    BEHAT: false
    PHPUNIT: true
    SELENIUM: true
